APP_ENV=production
APP_HOST=0.0.0.0
APP_PORT=8000
DB_PATH=/data/diskanalysis.db
DEFAULT_COLD_DAYS=90
DEFAULT_TOP_N=100
# Comma-separated roots to scan (empty = auto-discover all mounts)
SCAN_ROOTS=
# Paths to always exclude
EXCLUDE_PATHS=/proc,/sys,/dev,/run,/snap
# Comma-separated allowed fs types (empty = allow all)
ALLOWED_FS_TYPES=
# These fs types are treated as network filesystems
NETWORK_FS_TYPES=nfs,nfs4,cifs,smb3,smbfs,davfs,samba,fuse.sshfs,fuse.s3fs,glusterfs,cephfs,lustre
LOG_LEVEL=INFO
# Admin password (leave empty for open/single-user mode, set to enable login)
ADMIN_PASSWORD=
# Attribute files to users by top-level directory name before falling back to uid.
# Useful for NFS4 mounts without uid isolation. Set to false for uid-only mode.
PATH_USER_ATTRIBUTION=true
